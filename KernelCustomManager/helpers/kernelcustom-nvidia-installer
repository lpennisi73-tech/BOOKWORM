#!/usr/bin/python3 -I
"""
KernelCustom Manager - installation du pilote NVIDIA officiel (.run), en root via pkexec

Exécuter un .run téléchargé revient à exécuter du code arbitraire en root :
ce programme a donc sa propre action polkit (com.kernelcustom.manager.nvidia)
en auth_admin, SANS mémorisation du mot de passe.

Le .run est d'abord copié dans un dossier réservé à root (STAGE_DIR) : le fichier
exécuté ne peut plus être modifié par l'utilisateur entre la validation et l'exécution,
ni avant l'installation différée au démarrage.

Installation : /usr/libexec/kernelcustom-manager/kernelcustom-nvidia-installer (root:root 0755)
"""

import argparse
import os
import re
import shutil
import stat
import subprocess
import sys
from pathlib import Path

STAGE_DIR = Path('/var/lib/kernelcustom-manager/nvidia')
STAGED_RUN = STAGE_DIR / 'nvidia-installer.run'
SERVICE_NAME = 'kernelcustom-nvidia-install.service'
SERVICE_FILE = Path('/etc/systemd/system') / SERVICE_NAME
RUN_NAME_RE = re.compile(r'^NVIDIA-Linux-[A-Za-z0-9_]+-[0-9.]+\.run$')
DISPLAY_MANAGERS = ('gdm3', 'gdm', 'lightdm', 'sddm')
NVIDIA_UNINSTALL = Path('/usr/bin/nvidia-uninstall')


class InstallerError(Exception):
    pass


def caller_uid():
    try:
        return int(os.environ.get('PKEXEC_UID', '0'))
    except ValueError:
        return 0


def stage_run_file(path):
    """Valide le .run (nom, propriétaire) et le copie dans STAGE_DIR (root 0700)"""
    real = Path(os.path.realpath(path))
    try:
        st = real.stat()
    except OSError:
        raise InstallerError(f"fichier introuvable: {path}")
    if not stat.S_ISREG(st.st_mode) or not RUN_NAME_RE.match(real.name):
        raise InstallerError(f"fichier NVIDIA .run invalide: {path}")
    if st.st_uid not in (0, caller_uid()):
        raise InstallerError(f"le fichier n'appartient pas à l'utilisateur appelant: {path}")

    STAGE_DIR.mkdir(parents=True, exist_ok=True)
    os.chown(STAGE_DIR, 0, 0)
    os.chmod(STAGE_DIR.parent, 0o755)
    os.chmod(STAGE_DIR, 0o700)
    shutil.copyfile(real, STAGED_RUN)
    os.chmod(STAGED_RUN, 0o700)
    return STAGED_RUN


def run_installer(run_file):
    return subprocess.run(['/bin/sh', str(run_file), '--silent', '--no-questions']).returncode


def cmd_run(args):
    """Installation immédiate (à utiliser depuis un TTY, sans serveur graphique)"""
    code = run_installer(stage_run_file(args.run_file))
    STAGED_RUN.unlink(missing_ok=True)
    sys.exit(code)


def cmd_schedule(args):
    """Programme l'installation au prochain démarrage, avant le gestionnaire d'affichage"""
    stage_run_file(args.run_file)
    self_path = os.path.realpath(__file__)
    SERVICE_FILE.write_text(f"""[Unit]
Description=KernelCustom Manager - NVIDIA Driver Installation
After=multi-user.target
Before=display-manager.service

[Service]
Type=oneshot
ExecStart={self_path} boot-install
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
""")
    os.chmod(SERVICE_FILE, 0o644)
    subprocess.run(['systemctl', 'daemon-reload'], check=True)
    subprocess.run(['systemctl', 'enable', SERVICE_NAME], check=True)
    print(f"Installation programmée ({SERVICE_NAME})", flush=True)


def cmd_boot_install(args):
    """Appelé par systemd au démarrage : installe puis nettoie et redémarre"""
    for dm in DISPLAY_MANAGERS:
        subprocess.run(['systemctl', 'stop', dm], stderr=subprocess.DEVNULL)
    if STAGED_RUN.exists():
        print(f"Installation NVIDIA: code de retour {run_installer(STAGED_RUN)}", flush=True)
    subprocess.run(['systemctl', 'disable', SERVICE_NAME])
    SERVICE_FILE.unlink(missing_ok=True)
    STAGED_RUN.unlink(missing_ok=True)
    subprocess.run(['systemctl', 'daemon-reload'])
    subprocess.run(['systemctl', 'reboot'])


def cmd_cancel(args):
    """Annule une installation programmée"""
    subprocess.run(['systemctl', 'disable', SERVICE_NAME], stderr=subprocess.DEVNULL)
    SERVICE_FILE.unlink(missing_ok=True)
    STAGED_RUN.unlink(missing_ok=True)
    subprocess.run(['systemctl', 'daemon-reload'])


def cmd_uninstall(args):
    """Désinstalle un pilote installé via .run (nvidia-uninstall)"""
    if not NVIDIA_UNINSTALL.is_file():
        print("nvidia-uninstall absent: rien à faire", flush=True)
        return
    st = NVIDIA_UNINSTALL.stat()
    if st.st_uid != 0 or st.st_mode & 0o022:
        raise InstallerError(f"{NVIDIA_UNINSTALL} non fiable (doit appartenir à root)")
    sys.exit(subprocess.run([str(NVIDIA_UNINSTALL), '--silent']).returncode)


def main():
    parser = argparse.ArgumentParser(prog='kernelcustom-nvidia-installer')
    sub = parser.add_subparsers(dest='action', required=True)
    for name, func in (('run', cmd_run), ('schedule', cmd_schedule)):
        p = sub.add_parser(name)
        p.add_argument('run_file')
        p.set_defaults(func=func)
    sub.add_parser('boot-install').set_defaults(func=cmd_boot_install)
    sub.add_parser('cancel').set_defaults(func=cmd_cancel)
    sub.add_parser('uninstall').set_defaults(func=cmd_uninstall)
    args = parser.parse_args()

    if os.geteuid() != 0:
        print("ERROR: doit être exécuté en root (via pkexec)", file=sys.stderr)
        sys.exit(2)
    try:
        args.func(args)
    except (InstallerError, subprocess.CalledProcessError, OSError) as e:
        print(f"ERROR: {e}", file=sys.stderr)
        sys.exit(2)


if __name__ == '__main__':
    main()
